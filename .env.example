# Copy to .env and adjust. All variables use the LOG_INSPECTOR_ prefix.
LOG_INSPECTOR_ENVIRONMENT=local
LOG_INSPECTOR_LOG_LEVEL=INFO
LOG_INSPECTOR_DATABASE_URL=sqlite:///./log_inspector.db

# AWS CLI profile with the service's own credentials (the identity that assumes users' roles).
# Leave unset to use the standard AWS credential chain (AWS_PROFILE, env vars, task/instance role).
LOG_INSPECTOR_AWS_PROFILE=log-inspector

# Region for the service's own STS calls.
LOG_INSPECTOR_AWS_REGION=us-east-1
# ARN users must trust in their role's trust policy. Leave unset (recommended) to derive it
# from the credentials above; if set, it must match them.
# LOG_INSPECTOR_INSPECTOR_PRINCIPAL_ARN=arn:aws:iam::111122223333:user/log-inspector-service
LOG_INSPECTOR_ASSUME_ROLE_DURATION_SECONDS=3600

# Diagnosis (M4). Get a key at https://console.anthropic.com. Never commit .env.
ANTHROPIC_API_KEY=
# LOG_INSPECTOR_DIAGNOSIS_MODEL=claude-opus-5
# LOG_INSPECTOR_DIAGNOSIS_EFFORT=high
# Most time the whole Claude step may take (seconds), then how long it may go silent, and retries.
# LOG_INSPECTOR_DIAGNOSIS_TIMEOUT_SECONDS=480
# LOG_INSPECTOR_DIAGNOSIS_IDLE_TIMEOUT_SECONDS=90
# LOG_INSPECTOR_DIAGNOSIS_MAX_RETRIES=1

# Security and cost guards (M6). Limits are per user.
# LOG_INSPECTOR_RATE_LIMIT_PER_MINUTE=120
# LOG_INSPECTOR_EXPENSIVE_RATE_LIMIT_PER_HOUR=30
# LOG_INSPECTOR_MAX_ACTIVE_INVESTIGATIONS=3
# LOG_INSPECTOR_LOG_FORMAT=json

# Frontend origins allowed by CORS (comma-separated). Unset disables CORS.
# LOG_INSPECTOR_CORS_ORIGINS=http://localhost:4200

# Accept Cognito login tokens from this user pool and app client (the frontend). Unset = API keys only.
# LOG_INSPECTOR_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# LOG_INSPECTOR_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
